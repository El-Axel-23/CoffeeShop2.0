<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6EC"
    tools:context=".ProductoDetalleActivity">

    <!-- HEADER -->

    <LinearLayout
        android:id="@+id/headerProducto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:padding="4dp"
            android:contentDescription="Regresar"
            app:tint="#3B1F14"/>

        <TextView
            android:id="@+id/tvTituloProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Producto: Cappuccino Clásico"
            android:textColor="#3B1F14"
            android:textSize="13sp"/>

    </LinearLayout>


    <!-- CONTENIDO DESLIZABLE -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProducto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/headerProducto"
        app:layout_constraintBottom_toTopOf="@id/contenedorBoton">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="20dp">


            <!-- IMAGEN DEL PRODUCTO -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="158dp"
                android:layout_marginTop="8dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgProducto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/cafe_cappuccino"
                        android:contentDescription="Imagen del producto"/>

                </com.google.android.material.card.MaterialCardView>

                <!-- FAVORITOS -->

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <ImageButton
                        android:id="@+id/btnFavorito"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_favorite_border"
                        android:padding="7dp"
                        android:contentDescription="Agregar a favoritos"
                        app:tint="#3B1F14"/>

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>


            <!-- NOMBRE Y PRECIO -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNombreProducto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cappuccino Clásico"
                    android:textColor="#3B1F14"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPrecioProducto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$58"
                    android:textColor="#3B1F14"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

            </LinearLayout>


            <!-- DESCRIPCION -->

            <TextView
                android:id="@+id/tvDescripcionProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Espresso intenso con leche vaporizada y una capa generosa de espuma sedosa."
                android:textColor="#4A2E22"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>


            <!-- PERSONALIZACION -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Personalización"
                android:textColor="#3B1F14"
                android:textSize="17sp"
                android:textStyle="bold"/>


            <!-- TAMAÑO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tamaño"
                android:textColor="#3B1F14"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoTamano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipChico"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checked="true"
                    android:text="Chico"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMediano"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Mediano"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipGrande"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Grande"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

            </com.google.android.material.chip.ChipGroup>


            <!-- LECHE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Leche"
                android:textColor="#3B1F14"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoLeche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAvena"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Avena"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEntera"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:checked="true"
                    android:text="Entera"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDeslactosada"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Deslactosada"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAlmendra"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Almendra"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="12sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

            </com.google.android.material.chip.ChipGroup>


            <!-- EXTRAS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Extra"
                android:textColor="#3B1F14"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/grupoExtras"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSiropeVainilla"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Sirope Vainilla"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCanela"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="Canela"
                    android:textColor="@color/chip_text_selector"
                    android:textSize="13sp"
                    app:chipBackgroundColor="@color/chip_background_selector"
                    app:chipCornerRadius="25dp"
                    app:chipStrokeWidth="0dp"
                    app:checkedIconVisible="false"/>

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- BOTON FIJO AGREGAR AL CARRITO -->

    <LinearLayout
        android:id="@+id/contenedorBoton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF6EC"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarCarrito"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="AGREGAR AL CARRITO"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#3B1F14"
            app:cornerRadius="12dp"
            app:elevation="0dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>