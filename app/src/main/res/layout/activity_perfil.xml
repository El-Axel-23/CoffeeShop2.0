<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAtras"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_atras"
                    android:contentDescription="Regresar" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Mi perfil"
                    android:textColor="@color/cafe"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="#B00020"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_tarjeta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvIniciales"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_tarjeta"
                    android:backgroundTint="#F3D5BF"
                    android:gravity="center"
                    android:text="CE"
                    android:textColor="@color/cafe"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNombreUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cliente de ejemplo"
                        android:textColor="@color/cafe"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCorreoUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="cliente@example.com"
                        android:textColor="@color/gris"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tu espacio, tu pausa."
                android:textColor="@color/cafe"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/opVerPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_usuario"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Ver mi perfil"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/opPedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_pedidos"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Mis pedidos"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/opFavoritos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_favorito"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Favoritos"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/opUbicacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_ubicacion"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Ubicación"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/opConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_config"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Configuración"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/opAyuda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_ayuda"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Ayuda"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/opCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_salir"
                android:drawableEnd="@drawable/ic_flecha_der"
                android:drawablePadding="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="Cerrar sesión"
                android:textColor="@color/cafe"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Coffee Shop · Un momento delicioso en cada sorbo"
                android:textColor="@color/gris"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/barra_inferior" />

</LinearLayout>
